#!/usr/bin/env bash
set -euo pipefail

# Adapted from https://github.com/johannes-wolf/cetz/blob/35c0868378cea5ad323cc0d9c2f76de8ed9ba5bd/scripts/package
# Licensed under Apache License 2.0.

. "$(dirname "${BASH_SOURCE[0]}")/setup"

if (( $# < 1 )) || [[ "${1:-}" == "help" ]]; then
  cat <<EOF
package TARGET

Packages the relevant files into TARGET/<name>/<version>.
TARGET may be a path or @local / @preview to install into Typst's local package cache.
The package name and version are read from typst.toml.

Local package prefix: $DATA_DIR/typst/packages/local
Local preview package prefix: $DATA_DIR/typst/packages/preview
EOF
  exit 1
fi

TARGET="$(resolve-target "${1:?Missing target path, @local or @preview}")"
if [[ -d "$TARGET" ]]; then
  TARGET="$(cd "$TARGET" && pwd -P)"
else
  target_parent="$(dirname "$TARGET")"
  mkdir -p "$target_parent"
  TARGET="$(cd "$target_parent" && pwd -P)/$(basename "$TARGET")"
fi

# Never let packaging into the project (or one of its parents) overwrite source
# files. When the output is inside the project, skip it during file discovery so
# repeat packaging runs cannot include their own previous output.
if [[ "$TARGET" == "$ROOT" || "$ROOT" == "$TARGET/"* ]]; then
  echo "Refusing package target that contains the project: $TARGET" >&2
  exit 1
fi

OUTPUT_PATH=""
if [[ "$TARGET" == "$ROOT/"* ]]; then
  OUTPUT_PATH="./${TARGET#"$ROOT"/}"
fi

echo "Install dir: $TARGET"

readarray -t ignores < <(grep -v '^#' "$ROOT/.typstignore" | grep '[^[:blank:]]')

# Recursively list files that survive the ordered .typstignore patterns.
function enumerate {
  local current="$1"
  if [[ -f "$current" ]]; then
    echo "$current"
    return
  fi

  local files
  readarray -t files < <(find "$current" \
    -mindepth 1 -maxdepth 1 \
    -not -name .git \
    -not -name .typstignore)

  local file ignore include
  for file in "${files[@]}"; do
    include=1
    for ignore in "${ignores[@]}"; do
      if [[ "$ignore" =~ ^! ]]; then
        ignore="${ignore:1}"
        if [[ "$file" == ./$ignore ]]; then
          include=1
        fi
      elif [[ "$file" == ./$ignore ]]; then
        include=0
      fi
    done

    if [[ -n "$OUTPUT_PATH" && ( "$file" == "$OUTPUT_PATH" || "$file" == "$OUTPUT_PATH/"* ) ]]; then
      include=0
    fi

    if [[ "$include" == 1 ]]; then
      enumerate "$file"
    fi
  done
}

readarray -t files < <(cd "$ROOT" && enumerate ".")
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

for file in "${files[@]}"; do
  mkdir -p "$TMP/$(dirname "$file")"
  cp -r "$ROOT/$file" "$TMP/$file"
done

PACKAGE_DIR="$TARGET/${PKG_PREFIX}/${VERSION}"
echo "Packaged to: $PACKAGE_DIR"
if [[ -e "$PACKAGE_DIR" ]]; then
  rm -rf "$PACKAGE_DIR"
  echo "Overwriting existing version."
fi
mkdir -p "$PACKAGE_DIR"

# Include hidden package files when moving the staged contents.
shopt -s dotglob
mv "$TMP"/* "$PACKAGE_DIR/"
